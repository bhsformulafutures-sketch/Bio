# ── Storage (Supabase) ───────────────────────────────────────
# Leave both unset to run on the zero-config local file store (dev only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Browser push notifications (Web Push / VAPID) ────────────
# Set both to enable browser push. Leave them unset in dev: notifications
# stay dormant and are logged to the server console instead of delivered.
# Generate a keypair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact URL sent with each push (mailto: or https:).
VAPID_SUBJECT=mailto:hello@theotherhalf.app
