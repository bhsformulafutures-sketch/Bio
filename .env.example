# ── Storage (Supabase) ───────────────────────────────────────
# Leave both unset to run on the zero-config local file store (dev only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ─────────────────────────────────────────────────────
# Secret pepper for hashing one-time verification codes. Set to a long
# random string in production. Falls back to a dev constant if unset.
AUTH_SECRET=change-me-to-a-long-random-string

# ── Email notifications (Resend) ─────────────────────────────
# Set both to deliver real email (verification codes + notifications).
# Leave them unset in dev: codes are shown on-screen and messages are
# logged to the server console instead. Requires a verified sending
# domain/address in your Resend account (see resend.com/domains) — swap
# in a different provider by adding one to src/lib/notify/providers and
# wiring it in src/lib/notify/index.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
