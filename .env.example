# Supabase (Project Settings → API)
# Leave both unset to run on the zero-config local file store (dev only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phone verification (Required for production)
# Generate a random 32+ character string for hashing verification codes
AUTH_SECRET=your-long-random-string-here-min-32-chars

# SMS delivery (Optional - without these, codes show on-screen)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
